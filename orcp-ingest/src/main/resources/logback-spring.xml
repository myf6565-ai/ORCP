<?xml version="1.0" encoding="UTF-8"?>
<!--
    orcp-ingest logback configuration.

    Two appenders:
      * CONSOLE  : plain text, colour-coded; useful when running locally.
      * FILE     : JSON via logstash-logback-encoder 6.6 (JDK 8 compatible),
                   rolled daily, 14 days retained, 500MB total cap.

    Profile: when the 'prod' profile is active we drop the CONSOLE appender
    so systemd journald does not duplicate log lines that are already being
    written to disk.
-->
<configuration scan="true" scanPeriod="30 seconds">

    <springProperty name="APP_NAME" scope="context" source="spring.application.name" defaultValue="orcp-ingest"/>
    <property name="LOG_HOME" value="${ORCP_LOG_HOME:-/var/log/orcp}"/>
    <property name="LOG_FILE" value="${LOG_HOME}/${APP_NAME}.log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>Asia/Shanghai</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                </timestamp>
                <version/>
                <logLevel/>
                <loggerName/>
                <threadName/>
                <message/>
                <mdc/>
                <pattern>
                    <pattern>
                        {
                          "app":       "${APP_NAME}",
                          "traceId":   "%mdc{traceId}",
                          "spanId":    "%mdc{spanId}"
                        }
                    </pattern>
                </pattern>
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxLength>4096</maxLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="com.orcp"                     level="INFO"/>
    <logger name="org.apache.kafka"             level="INFO"/>
    <logger name="org.springframework.kafka"    level="INFO"/>
    <logger name="com.baomidou.mybatisplus"     level="INFO"/>
    <logger name="com.alibaba.nacos"            level="WARN"/>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

</configuration>

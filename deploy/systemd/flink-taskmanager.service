[Unit]
Description=Apache Flink TaskManager（ORCP）
Documentation=https://flink.apache.org/
Requires=network-online.target
After=network-online.target flink-jobmanager.service

[Service]
Type=simple
User=orcp
Group=orcp
Environment=JAVA_HOME=/opt/jdk-8
Environment=FLINK_LOG_DIR=/var/log/orcp/flink
Environment=FLINK_PID_DIR=/var/run/flink
ExecStartPre=/bin/mkdir -p /var/run/flink
ExecStartPre=/bin/chown orcp:orcp /var/run/flink
ExecStart=/opt/flink/bin/taskmanager.sh start-foreground
ExecStop=/opt/flink/bin/taskmanager.sh stop
Restart=on-failure
RestartSec=10
LimitNOFILE=655360
LimitNPROC=655360
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

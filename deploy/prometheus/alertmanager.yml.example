# Alertmanager 0.26.x configuration for ORCP.
#
# Copy to /opt/alertmanager/alertmanager.yml (or wherever you install
# Alertmanager) and replace the webhook URL below with the real dingtalk
# or feishu endpoint.
#
# Install reference (standalone, systemd):
#   wget https://github.com/prometheus/alertmanager/releases/download/v0.26.0/alertmanager-0.26.0.linux-amd64.tar.gz
#   tar -xzf alertmanager-0.26.0.linux-amd64.tar.gz -C /opt && ln -sfn /opt/alertmanager-0.26.0.linux-amd64 /opt/alertmanager
#   systemd unit: ExecStart=/opt/alertmanager/alertmanager --config.file=/opt/alertmanager/alertmanager.yml
#
# Then tell Prometheus about it in prometheus.yml:
#   alerting:
#     alertmanagers:
#       - static_configs:
#           - targets: ['127.0.0.1:9093']

global:
  resolve_timeout: 5m

route:
  # Every alert, critical or warning, hits a single default receiver.  Split
  # into multiple receivers once you have more than one pager group.
  receiver: orcp-webhook
  group_by: ['alertname', 'service']
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 1h
  routes:
    - matchers: [ severity="critical" ]
      receiver: orcp-webhook
      repeat_interval: 15m

receivers:
  - name: orcp-webhook
    webhook_configs:
      # Dingtalk / Feishu don't accept Alertmanager's native JSON format;
      # put an adapter (e.g. prometheus-webhook-dingtalk) in front:
      #
      #   systemctl enable --now prometheus-webhook-dingtalk
      #   url: http://127.0.0.1:8060/dingtalk/orcp/send
      #
      # For a minimum install without the adapter, point at an inbound
      # webhook that accepts arbitrary JSON (Slack-compatible endpoints
      # work; Dingtalk raw endpoints need signing, which is out of scope).
      - url: http://127.0.0.1:8060/dingtalk/orcp/send
        send_resolved: true

inhibit_rules:
  # Don't page on per-job alerts when the whole service is already down.
  - source_matchers: [ alertname="OrcpSpringServiceDown" ]
    target_matchers:  [ service="orcp-ingest" ]
    equal: [ instance ]

# -----------------------------------------------------------------------------
# ORCP 集群拓扑配置。
#
# 在运行任何安装脚本 **之前**，请将本文件复制到每个节点的 /etc/orcp/cluster.env：
#
#     sudo install -m 0644 deploy/centos/cluster.env.example /etc/orcp/cluster.env
#     sudo vi /etc/orcp/cluster.env              # 设置本节点的 NODE_ID 和主机名
#
# 所有 deploy/centos/*.sh 脚本都会 source 此文件。每个节点上的内容保持一致，
# 唯一的差异是 NODE_ID。
# -----------------------------------------------------------------------------

# 本节点编号，取值范围 1..NODE_COUNT，每台主机必须唯一。
NODE_ID=1

# 集群节点总数（生产环境通常为 3，单机 POC 时设为 1）。
NODE_COUNT=3

# 各节点的主机名 / IP。用于构建 Kafka broker 列表、ZooKeeper 集群和 Flink masters/workers。
NODE_1_HOST=node-1
NODE_2_HOST=node-2
NODE_3_HOST=node-3

# 所有服务文件的属主用户，由 00_bootstrap.sh 负责创建。
ORCP_USER=orcp
ORCP_GROUP=orcp

# 可选：如有内部 Apache 镜像，在此覆盖。
# 示例：ORCP_APACHE_MIRROR=https://mirrors.example.com/apache
ORCP_APACHE_MIRROR=https://archive.apache.org/dist

# 可选：下载产物本地缓存目录。
ORCP_DOWNLOAD_CACHE=/var/cache/orcp/downloads

# -----------------------------------------------------------------------------
# ORCP cluster topology.
#
# Copy to /etc/orcp/cluster.env on EVERY node BEFORE running any install script:
#
#     sudo install -m 0644 deploy/centos/cluster.env.example /etc/orcp/cluster.env
#     sudo vi /etc/orcp/cluster.env              # set NODE_ID and hosts
#
# All deploy/centos/*.sh scripts source this file. Keep the file identical on
# every node EXCEPT for NODE_ID.
# -----------------------------------------------------------------------------

# This node's id, 1..NODE_COUNT. Must be unique per host.
NODE_ID=1

# Total node count (typically 3 for production, 1 for a POC on a single box).
NODE_COUNT=3

# Hostnames / IPs for each node. Used to build Kafka broker lists, the
# ZooKeeper ensemble, and Flink masters/workers.
NODE_1_HOST=node-1
NODE_2_HOST=node-2
NODE_3_HOST=node-3

# User that owns all service files and runs all daemons. Created by
# 00_bootstrap.sh if missing.
ORCP_USER=orcp
ORCP_GROUP=orcp

# Optional: override the Apache archive mirror if you have an internal one.
# Example: ORCP_APACHE_MIRROR=https://mirrors.example.com/apache
ORCP_APACHE_MIRROR=https://archive.apache.org/dist

# Optional: local cache for downloaded artefacts.
ORCP_DOWNLOAD_CACHE=/var/cache/orcp/downloads
